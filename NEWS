<script>
  const demoUsers = { "admin":"1234", "user1":"pass1", "user2":"pass2" };
  let currentUser = null;
  let mainWallet=0, gameWallet=0, totalBet=0, cashbackAmount=0, winRate=30;

  function updateDisplay(){
    document.getElementById("mainWallet").textContent = mainWallet.toFixed(2);
    document.getElementById("gameWallet").textContent = gameWallet.toFixed(2);
    document.getElementById("totalBet").textContent = totalBet.toFixed(2);
    document.getElementById("cashback").textContent = cashbackAmount.toFixed(2);
  }
  function resetMsgs(){
    ["deposit-msg","transfer-msg","game-result","cashback-msg","redeem-msg","copy-msg"].forEach(id=>document.getElementById(id).textContent="");
  }

  function login(){
    const u = document.getElementById("login-username").value.trim();
    const p = document.getElementById("login-password").value.trim();
    if(demoUsers[u]===p){
      currentUser=u;
      document.getElementById("login-section").classList.add("hidden");
      document.getElementById("app").classList.remove("hidden");
      document.getElementById("user-display").textContent=u;
      if(u==="admin") document.getElementById("admin-panel").classList.remove("hidden");
      updateDisplay(); resetMsgs();
    } else {
      document.getElementById("login-error").textContent="ไม่ถูกต้อง!";
    }
  }
  function logout(){ location.reload(); }

  function deposit(){
    const amt=parseFloat(document.getElementById("depositAmount").value);
    if(amt>0){ mainWallet+=amt; updateDisplay(); } else { document.getElementById("deposit-msg").textContent="กรอกถูกต้อง"; }
  }
  function transferToGame(){
    const amt=parseFloat(document.getElementById("transferAmount").value);
    if(amt>0 && amt<=mainWallet){ mainWallet-=amt; gameWallet+=amt; updateDisplay(); } else {
      document.getElementById("transfer-msg").textContent="ยอดไม่พอ";
    }
  }

  function getFreeSpinPrice(level){
    if(level===1) return 50;
    if(level===2) return 75;
    if(level===3) return 100;
    if(level===4) return 150;
    if(level===5) return 175;
    if(level>=6 && level<=9) return 175 + (level-5)*60;
    return 415 + (level-9)*75;
  }

  function spin(){
    const lvl=parseInt(document.getElementById("betAmount").value);
    if(lvl>gameWallet) { document.getElementById("game-result").textContent="ยอดไม่พอ"; return; }
    gameWallet-=lvl;
    const isWin=Math.random()*100<winRate;
    let res="", win=0;
    if(isWin){
      const mul=[1,1.5,2,3,5,10,20][Math.floor(Math.random()*7)];
      win=lvl*mul; gameWallet+=win;
      res=`You win! ได้ ${win.toFixed(2)} (x${mul})`;
    } else res="เสียแล้วลองใหม่";
    totalBet+=lvl; cashbackAmount = totalBet*0.005;
    updateDisplay(); document.getElementById("game-result").textContent=res;
  }

  function buyFreeSpins(){
    const lvl=parseInt(document.getElementById("betAmount").value);
    const cost=getFreeSpinPrice(lvl);
    if(cost>gameWallet){ document.getElementById("game-result").textContent="ยอดไม่พอซื้อฟรีสปิน"; return }
    gameWallet-=cost; let totalWin=0;
    for(let i=0;i<10;i++){
      const isWin=Math.random()*100<winRate;
      if(isWin){
        const mul=[1,1.5,2,3,5,10,20][Math.floor(Math.random()*7)];
        totalWin+=lvl*mul;
      }
    }
    gameWallet+=totalWin; totalBet+=cost; cashbackAmount = totalBet*0.005;
    updateDisplay();
    document.getElementById("game-result").innerHTML=`ซื้อฟรี 10 ครั้ง ได้ ${totalWin.toFixed(2)} บาท (ใช้ ${cost} บาท)`;
  }

  function claimCashback(){
    if(cashbackAmount>0){
      mainWallet+=cashbackAmount;
      document.getElementById("cashback-msg").textContent=`ได้รับคืน ${cashbackAmount.toFixed(2)} บาท`;
      totalBet=0; cashbackAmount=0;
      updateDisplay();
    }
  }

  function setWinRate(){
    const val=parseInt(document.getElementById("winRateInput").value);
    if(!isNaN(val) && val>=0 && val<=100){ winRate=val;
      document.getElementById("admin-msg").textContent=`ตั้งค่า ${winRate}% แล้ว`;
    } else { document.getElementById("admin-msg").textContent="ค่าผิด"; }
  }

  function redeem(){
    const code=document.getElementById("redeemCode").value.trim();
    if(code==="FREE100"){ mainWallet+=100; document.getElementById("redeem-msg").textContent="แลกโค้ดสำเร็จ"; } 
    else document.getElementById("redeem-msg").textContent="โค้ดไม่ถูกต้อง";
  }

  function copyReferral(){
    const input = document.getElementById("referralInput");
    input.select(); document.execCommand("copy");
    document.getElementById("copy-msg").textContent="คัดลอกแล้ว!";
  }
</script>

