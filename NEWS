<script>
  // ตัวแปรเก็บสถานะ
  const demoUsers = { "admin": "1234", "user1": "pass1", "user2": "pass2" };
  let mainWallet = 0;
  let gameWallet = 0;
  let totalBet = 0;
  let cashbackAmount = 0;

  const loginSection = document.getElementById("login-section");
  const appSection = document.getElementById("app");
  const userDisplay = document.getElementById("user-display");
  const loginError = document.getElementById("login-error");

  // Wallet elements
  const mainWalletEl = document.getElementById("mainWallet");
  const gameWalletEl = document.getElementById("gameWallet");
  const depositMsg = document.getElementById("deposit-msg");
  const transferMsg = document.getElementById("transfer-msg");
  const totalBetEl = document.getElementById("totalBet");
  const cashbackEl = document.getElementById("cashback");
  const cashbackMsg = document.getElementById("cashback-msg");
  const gameResult = document.getElementById("game-result");

  function login() {
    const username = document.getElementById("login-username").value.trim();
    const password = document.getElementById("login-password").value.trim();

    if (demoUsers[username] && demoUsers[username] === password) {
      localStorage.setItem("loggedInUser", username);
      loginSection.classList.add("hidden");
      appSection.classList.remove("hidden");
      userDisplay.textContent = username;

      // โหลดยอดเงิน (ถ้าเก็บจริงให้ดึงจาก backend)
      mainWallet = 0;
      gameWallet = 0;
      totalBet = 0;
      cashbackAmount = 0;
      updateWalletDisplay();
      resetMessages();
    } else {
      loginError.textContent = "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง";
    }
  }

  function logout() {
    localStorage.removeItem("loggedInUser");
    location.reload();
  }

  function updateWalletDisplay() {
    mainWalletEl.textContent = mainWallet.toFixed(2);
    gameWalletEl.textContent = gameWallet.toFixed(2);
    totalBetEl.textContent = totalBet.toFixed(2);
    cashbackEl.textContent = cashbackAmount.toFixed(2);
  }

  function resetMessages() {
    depositMsg.textContent = "";
    transferMsg.textContent = "";
    cashbackMsg.textContent = "";
    gameResult.textContent = "";


function getFreeSpinPrice(betLevel) {
  if (betLevel === 1) return 50;
  if (betLevel === 2) return 75;
  if (betLevel === 3) return 100;
  if (betLevel === 4) return 150;
  if (betLevel === 5) return 175;
  if (betLevel >= 6 && betLevel <= 9) {
    return 175 + (betLevel - 5) * 60;
  }
  if (betLevel >= 10) {
    return 415 + (betLevel - 9) * 75;
  }
}


